# LenspireCRM — environment variable reference
#
# This file documents every environment variable consumed by the project.
# Worker secrets go through `wrangler secret put` (never committed).
# Script and desktop vars are set in the local shell or a `.env` file.

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Worker secrets  (npx wrangler secret put <NAME>)
# ─────────────────────────────────────────────────────────────────────────────

# Required for owner/platform-admin authentication and session JWTs.
# Generate a strong random secret (>= 32 characters).
#  npx wrangler secret put JWT_SECRET
JWT_SECRET=

# Google Drive integration for quotation uploads/listing.
# OAuth2 client credentials for the OAuth client the Worker uses to impersonate
# studio users. The refresh token is NOT a secret here — it is stored encrypted
# in Postgres, keyed by DRIVE_TOKEN_KEY below.
#  npx wrangler secret put GOOGLE_CLIENT_ID
#  npx wrangler secret put GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-character key used to encrypt/decrypt the persisted Google Drive refresh
# token in the database. Must be exactly 32 characters.
#  npx wrangler secret put DRIVE_TOKEN_KEY
DRIVE_TOKEN_KEY=

# 32-character key used to encrypt auto-backup data stored in the database.
# Used by the Worker's scheduled auto-backup handler. If not set, auto-backups
# are stored unencrypted (JSON) — encrypted backups are strongly recommended.
#  npx wrangler secret put BACKUP_ENCRYPTION_KEY
BACKUP_ENCRYPTION_KEY=

# LenspireCRM recovery / owner-password-reset token.
# A random Base64URL string of >= 48 bytes. Keep it in the approved
# password manager only. See cloudflare-worker/RECOVERY.md.
#  npx wrangler secret put SETUP_TOKEN
SETUP_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Maintenance scripts  (scripts/*.js)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the deployed Worker API. Defaults to the staging endpoint when
# unset. Used by scripts/run-cloud-migrations.js and scripts/smoke-production.js.
LENSPIRE_API_URL=

# Base URL for the client-facing portal subdomain (e.g. portal.lenspireai.com).
# When set, the Worker generates client portal links as
# https://<PORTAL_DOMAIN>/<studio-slug>/<client-slug>#<token> instead of the
# legacy /client-portal#<token> path format. If unset, it is derived from the
# request hostname.
PORTAL_DOMAIN=

# Bearer token of an authenticated owner/platform-admin. Required by
# scripts/run-cloud-migrations.js and optionally used by smoke-production.js.
# LENSPIRE_OWNER_ACCESS_TOKEN=

# Smoke-test credentials (alternative to LENSPIRE_OWNER_ACCESS_TOKEN when
# running scripts/smoke-production.js against a fresh environment).
# LENSPIRE_SMOKE_USERNAME=
# LENSPIRE_SMOKE_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Desktop app / local development  (src/database/db.js, src/main/cloud-api.js)
# ─────────────────────────────────────────────────────────────────────────────

# Overrides the default SQLite database path on desktop and in local tests.
# Set this to a temp file before requiring db.js in tests to avoid touching
# the real tracker.db.
# LENSPIRE_DB_PATH=/tmp/my-tracker.db

# Overrides the deployed API URL used by the Electron desktop client's cloud
# sync layer (src/main/cloud-api.js).
# LENSPIRECRM_API_URL=https://crm.lenspireai.com
LENSPIRECRM_API_URL=
